{
  "name": "pose-fitness-coach",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "私人智能教练：摄像头姿态识别（MediaPipe）+ 可解释的规则引擎（深蹲 / 开合跳计数与纠错），离线双击即用的课堂演示",
  "scripts": {
